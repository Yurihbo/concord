rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /communities/{communityId}/voiceRooms/{roomId}/{userId}/{fileName} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid));
      allow write: if request.auth != null
        && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid))
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/.*|audio/.*|image/.*|text/.*|video/.*');
    }
  }
}
